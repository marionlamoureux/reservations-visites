# Copy to .env on the server and fill in. Loaded by the systemd service.
SECRET_KEY=replace-with-a-long-random-string
ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# Email notification via Resend (https://resend.com — free tier)
# You can use either a single address or multiple recipients separated by commas or semicolons.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
NOTIFY_EMAIL=you@example.com,other@example.com
# Until you verify your own domain in Resend, keep the default sender:
FROM_EMAIL=ileart_demande_visite@resend.dev
